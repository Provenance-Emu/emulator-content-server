# Flycast needs its GLES symbol table and carries its own CHD decoder.
RARCH_OBJ := $(filter-out obj-emscripten/./libretro-common/glsym/glsym_es3.o obj-emscripten/./libretro-common/formats/libchdr/% obj-emscripten/./libretro-common/streams/chd_stream.o,$(RARCH_OBJ))
ECS_JIT_EXPORTS := _wasm_mem_read8,_wasm_mem_read16,_wasm_mem_read32,_wasm_mem_write8,_wasm_mem_write16,_wasm_mem_write32,_wasm_exec_ifb,_wasm_exec_shil_fb,_wasm_sq_pref,_wasm_div32u,_wasm_div32s,_wasm_div1,_fly_ram_ptr,_fly_ram_size,_fly_vram_ptr,_fly_vram_size,_fly_frame_count,_ecs_jit_executed_blocks,_ecs_jit_executor_mode
LDFLAGS += -s EXPORTED_FUNCTIONS="$(EXPORTED_FUNCTIONS),$(ECS_JIT_EXPORTS)" -s ALLOW_TABLE_GROWTH=1 -s DYNAMIC_EXECUTION=0 -s DISABLE_EXCEPTION_CATCHING=0 -fexceptions -Wl,--error-limit=0
LIBS += $(ECS_FLYCAST_BUILD)/ecs-flycast-compat.o $(ECS_FLYCAST_BUILD)/core/deps/libzip/lib/libzip.a $(ECS_FLYCAST_BUILD)/core/deps/libelf/libelf.a $(ECS_FLYCAST_BUILD)/core/deps/miniupnpc/libminiupnpc.a $(ECS_FLYCAST_BUILD)/libflycast-resources.a $(ECS_FLYCAST_BUILD)/core/deps/tinygettext/libtinygettext.a $(ECS_FLYCAST_BUILD)/core/deps/nowide/libnowide.a $(ECS_FLYCAST_BUILD)/core/deps/libchdr/libchdr-static.a $(ECS_FLYCAST_BUILD)/core/deps/libchdr/deps/lzma-24.05/liblzma.a $(ECS_FLYCAST_BUILD)/core/deps/libchdr/deps/zstd-1.5.6/build/cmake/lib/libzstd.a $(ECS_FLYCAST_BUILD)/core/deps/libchdr/deps/zlib-1.3.1/libz.a $(ECS_FLYCAST_BUILD)/core/deps/xxHash/cmake_unofficial/libxxhash.a
