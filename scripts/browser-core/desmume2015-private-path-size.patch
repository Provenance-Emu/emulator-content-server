+                         -Dpath_is_character_special=desmume2015_path_is_character_special \
+                         -Dpath_is_valid=desmume2015_path_is_valid
+   CFLAGS += $(PRIVATE_STAT_FLAGS)
+   CXXFLAGS += $(PRIVATE_STAT_FLAGS)
    STATIC_LINKING = 1
 
