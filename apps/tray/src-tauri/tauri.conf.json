{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Emulation Server",
  "version": "0.1.4",
  "identifier": "org.provenance.contentserver.tray",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "pnpm --filter @ecs/tray dev",
    "beforeBuildCommand": "pnpm --filter @ecs/tray build"
  },
  "app": {
    "windows": [
      {
        "label": "status",
        "title": "Emulation Server",
        "width": 420,
        "height": 720,
        "resizable": true,
        "visible": false,
        "skipTaskbar": true,
        "decorations": true,
        "create": false
      },
      {
        "label": "library",
        "title": "Emulation Server Library",
        "url": "library.html",
        "width": 1200,
        "height": 800,
        "minWidth": 620,
        "minHeight": 480,
        "resizable": true,
        "visible": false,
        "decorations": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset:; media-src blob:; connect-src 'self' ipc: http://ipc.localhost http: https:"
    },
    "trayIcon": {
      "id": "status",
      "iconPath": "icons/tray.png",
      "iconAsTemplate": true,
      "showMenuOnLeftClick": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "deb", "appimage"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
