{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Content Server Status",
  "version": "0.1.0",
  "identifier": "org.provenance.contentserver.tray",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "pnpm --filter @ecs/tray dev",
    "beforeBuildCommand": "pnpm --filter @ecs/tray build"
  },
  "app": {
    "windows": [
      {
        "label": "status",
        "title": "Content Server Status",
        "width": 420,
        "height": 560,
        "resizable": true,
        "visible": false,
        "skipTaskbar": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* https:"
    },
    "trayIcon": {
      "id": "status",
      "iconPath": "icons/tray.png",
      "iconAsTemplate": true,
      "showMenuOnLeftClick": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "deb", "appimage"],
    "icon": ["icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
