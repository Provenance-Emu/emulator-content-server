{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Bundled status and library windows; remote documents have no native capabilities.",
  "windows": ["status", "library"],
  "permissions": [
    "core:default",
    "core:tray:default",
    "core:menu:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:app:allow-default-window-icon",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "http://*"
        },
        {
          "url": "https://*"
        }
      ]
    },
    "process:allow-exit",
    "allow-service-status",
    "allow-service-start",
    "allow-service-stop"
  ]
}
