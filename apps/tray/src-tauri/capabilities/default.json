{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the status window is allowed to ask the native side for.",
  "windows": ["status"],
  "permissions": [
    "core:default",
    "core:tray:default",
    "core:menu:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:app:allow-default-window-icon",
    "opener:allow-open-url",
    "process:allow-exit"
  ]
}
