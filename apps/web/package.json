  },
  "dependencies": {
    "@ecs/client": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "6.2.1",
    "svelte": "5.57.2",
    "svelte-check": "4.3.4",
    "vite": "7.3.5",
    "@ecs/server": "workspace:*"
  }
}
