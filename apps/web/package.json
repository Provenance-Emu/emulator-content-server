{
  "name": "@ecs/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./lib/problems": "./src/lib/problems.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "check": "svelte-check --tsconfig ./tsconfig.json && pnpm test",
