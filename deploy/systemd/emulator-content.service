[Unit]
Description=Emulator Content Server
After=network.target

[Service]
Type=simple
User=emulator-content
WorkingDirectory=/var/lib/emulator-content
ExecStart=/usr/bin/node /opt/emulator-content-server/apps/cli/dist/src/main.js serve --data /var/lib/emulator-content --host 0.0.0.0 --port 8473
Restart=on-failure
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
